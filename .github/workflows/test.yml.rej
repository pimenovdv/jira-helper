--- .github/workflows/test.yml
+++ .github/workflows/test.yml
@@ -24,8 +24,8 @@ jobs:
       run: cd tech-leader-assistant && uv sync --dev

     - name: Install Playwright Browsers
-      run: cd tech-leader-assistant && uv run playwright install --with-deps
+      run: cd tech-leader-assistant && PLAYWRIGHT_BROWSERS_PATH=0 uv run playwright install --with-deps chromium

     - name: Run tests with pytest
       run: |
-        cd tech-leader-assistant && uv run pytest --cov=app --cov-report=term-missing --cov-fail-under=80 tests/
+        cd tech-leader-assistant && PLAYWRIGHT_BROWSERS_PATH=0 xvfb-run uv run pytest --cov=app --cov-report=term-missing --cov-fail-under=80 tests/
